
// Global default params, used in configs

params {
    // Input and output parameters
    genome_extension = 'fa'
    min_completeness = 70
    max_contamination = 5
    level = 'order' 
    input = null
    outdir = null

    // Database paths
    checkm2_db = '/share/cn1_fs/database/checkm2/CheckM2_database/uniref100.KO.1.dmnd'
    gtdbtk_db = '/share/cn1_fs/database/GTDB_R232/release232'
    gtdb_auxillary_metadata = "/share/data01/project/xujinxin/database/gtdb_r232/auxillary_files/metadata_r232.tsv"
    gtdbtk_genome = '/home/database/GTDB_R232/genomic_fasta_reps'
    bakta_db = '/share/data01/project/xujinxin/database/bakta/db-light'
    eggNOG_db = '/share/data01/project/xujinxin/database/eggNOG7'
    dbcan_db = '/share/data01/project/xujinxin/database/dbcan5'
    card_db = '/share/data01/project/xujinxin/database/card'
    vf_db = '/share/data01/project/xujinxin/database/vfdb/VFDB_setA_pro.dmnd'
    antismash_db = '/share/data01/project/xujinxin/database/antismash'
    pfam_db = '/home/xujinxin/database/antismash/pfam/35.0'
    macsyfinder_models = '/home/xujinxin/database/macsyfinder/models'
    cctyper_db = '/share/data01/project/xujinxin/software/miniconda3/envs/cctyper/lib/python3.14/site-packages/cctyper/data'
    hgtector2_db = '/share/cn1_fs/database/hgtector_gtdbR232'
    merops_db = '/share/cn1_fs/database/merops/pepunit.dmnd'
}


process {
    executor = 'local'
    cpus = 4
    memory = '20.GB'
    time = '24.h'
    maxForks = 40
    errorStrategy = "finish"
}

profiles {
    local {
        process.executor = 'local'
    }

    slurm {
        process {
            executor = 'slurm'
            queue = 'gn'
            cpus = 4
            memory = '20.GB'
            time = '24.h'
            clusterOptions = '--no-requeue'
        }

        executor {
            name = 'slurm'
            queueSize = 100 
            pollInterval = '1 min'
            submitRateLimit = '10/1sec'
            queueStatInterval = '5 min'
        }
    }

}

singularity {
    cacheDir = '/share/data01/project/xujinxin/project/20260910_nextflow_v2/container'
    enabled = true
    autoMounts = true 
}

includeConfig './modules/checkm2.config'
includeConfig './modules/skder.config'
includeConfig './modules/gtdbtk.config'
includeConfig './modules/gtdb_select_representative.config'
includeConfig './modules/root_tree.config'
includeConfig './modules/pyrodigal.config'
includeConfig './modules/orthofinder.config'
includeConfig './modules/bakta.config'
includeConfig './modules/eggNOG.config'
includeConfig './modules/cazyme.config'
includeConfig './modules/card.config'
includeConfig './modules/vf.config'
includeConfig './modules/merops.config'
includeConfig './modules/cgcfinder.config'
includeConfig './modules/antismash.config'
includeConfig './modules/bigscape.config'
includeConfig './modules/defensefinder.config'
includeConfig './modules/crisprcastyper.config'
includeConfig './modules/hgtector2.config'
includeConfig './modules/iqtree_og.config'